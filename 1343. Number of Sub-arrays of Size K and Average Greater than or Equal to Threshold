class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int windowSum = 0, res = 0;

        for (int i = 0; i < k; i++) {
            windowSum += arr[i];
        }

        if (windowSum / k >= threshold) {
            res++;
        }

        for (int i = 1; i <= arr.size() - k; i++) {
            windowSum += arr[i + k - 1];
            windowSum -= arr[i - 1];

            if (windowSum / k >= threshold) {
                res++;
            }
        }

        return res;
    }
};
