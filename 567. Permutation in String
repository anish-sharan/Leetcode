class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        vector<int> s1v(26, 0), s2v(26, 0);

        if(s1.length()>s2.length()){
            return false;
        }
        
        for (auto it : s1) {
            s1v[it - 'a']++;
        }

        for (int i = 0; i < s1.size(); i++) {
            s2v[s2[i] - 'a']++;
        }

        if (s1v == s2v) {
            return true;
        }

        for (int i = 1; i <= s2.size() - s1.size(); i++) {
            s2v[s2[i - 1] - 'a']--;
            s2v[s2[i + s1.size() - 1] - 'a']++;

            if (s1v == s2v) {
                return true;
            }
        }

        return false;
    }
};
