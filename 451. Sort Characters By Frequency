class Solution {
public:
    static bool cmp(pair<char, int>& a, pair<char, int>& b) {
        return a.second > b.second;
    }

    string frequencySort(string s) {

        map<char, int> mp;
        string st;

        for (auto it : s) {
            mp[it]++;
        }

        vector<pair<char,int>> vp(mp.begin(),mp.end());
        sort(vp.begin(), vp.end(), cmp);

        for (auto& it : vp) {
            st += string(it.second, it.first);
        }

        return st;
    }
};
