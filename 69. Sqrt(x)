class Solution {
public:
    int mySqrt(int x) {
        if (x == 0 || x == 1)
            return x;

        if (x == 2 || x==3)
            return 1;

        long long l = 2, r = x, mid, res = 0;

        while (l <= r) {
            mid = l + (r - l) / 2;

            if (mid * mid == x) {
                return mid;
            }

            else if (mid * mid <= x) {
                res = mid;
                l = mid + 1;
            }

            else {
                r = mid - 1;
            }
        }

        return res;
    }
};
