class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int n = nums.size();
        vector<vector<int>> ans;

        for (int i = 0; i < n - 2; i++) {
            if (i > 0 && nums[i] == nums[i - 1])
                continue;

            int j = i + 1, k = n - 1;

            while (j < k) {
                vector<int> temp;
                int a = nums[i], b = nums[j], c = nums[k];
                if ((a + b + c) == 0) {
                    temp.push_back(a);
                    temp.push_back(b);
                    temp.push_back(c);
                    ans.push_back(temp);

                    j++;
                    k--;
                    
                    while (j < k && nums[j] == nums[j - 1])
                        j++;
                    while (j < k && nums[k] == nums[k + 1])
                        k--;
                } else if ((a + b + c) < 0) {
                    j++;
                } else {
                    k--;
                }
            }
        }

        return ans;
    }
};
