class Solution {
public:
    int max(int a, int b) { return a > b ? a : b; }
    int min(int a, int b) { return a > b ? b : a; }

    int maxProfit(vector<int>& prices) {
        int res = 0, mini = prices[0];

        for(auto it:prices)
        {
            res = max(res,it - mini);
            mini = min(mini,it);
        }
        
        return res;
    }
};
