class Solution {
public:
    int reverse(int x) {
        long long res = 0, last = 0, num = x;
        bool isNeg = false;

        if (num < 0) {
            num = abs(num);
            isNeg = true;
        }

        while (num > 0) {
            last = num % 10;
            res = res * 10 + last;
            num /= 10;
        }

        if (isNeg) {
            res = -res;
        }

        if (res > INT_MAX || res < INT_MIN) {
            return 0;
        }

        return res;
    }
};
