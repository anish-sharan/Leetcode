class Solution {
public:
    int numberOfSpecialChars(string word) {
        map<char, int> mp;
        int count = 0;

        for (auto it : word) {
            mp[it]++;
        }

        for (int i = 0; i < word.length(); i++) {
            int ch = word[i];

            if (ch >= 'a' && ch <= 'z') {
                if (mp[ch] > 0 && mp[toupper(ch)] > 0) {
                    count++;
                    mp.erase(ch);
                }
            }
            if (ch >= 'A' && ch <= 'Z') {
                if (mp[ch] > 0 && mp[tolower(ch)] > 0) {
                    count++;
                    mp.erase(ch);
                }
            }
        }

        return count;
    }
};
