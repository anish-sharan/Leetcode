class Solution {
public:
    int countBit(int n) {
        int res = 0;
        while (n > 0) {
            n = n & (n - 1);
            res++;
        }
        return res;
    }
    vector<int> countBits(int n) {
        vector<int> ans;

        for (int i = 0; i <= n; i++) {
            ans.push_back(countBit(i));
        }

        return ans;
    }
};
